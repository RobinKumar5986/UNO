<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
    <uses-permission android:name="android.permission.USB_PERMISSION" />
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        For the step counter in SensorCatalog. Android 10 hides that sensor from the sensor list
        until this is granted, so without it the card reads "Unavailable" on phones that do have
        the hardware.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <!--
        For the heart rate sensor in SensorCatalog. Optional hardware — almost no phone has it,
        and the sensors screen already greys out cards the phone cannot back.

        Android 16 stopped honouring BODY_SENSORS for apps targeting it and moved the monitor
        behind READ_HEART_RATE. Note that declaring a health permission brings Play Store policy
        requirements with it — drop the heart rate sensor from SensorCatalog and both of these
        lines if that isn't worth it.
    -->
    <uses-permission android:name="android.permission.BODY_SENSORS"
        android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-feature android:name="android.hardware.sensor.heartrate" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/unologomain"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UNO">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.UNO.Splash"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".screens.EditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="landscape" />

        <activity
            android:name=".screens.SavedProjectsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="landscape" />

        <activity
            android:name=".screens.AiChatActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />
    </application>

</manifest>