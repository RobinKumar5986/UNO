<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_card"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/readoutChannelName"
            style="@style/TextAppearance.UNO.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Azimuth" />

        <TextView
            android:id="@+id/readoutChannelValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/exe_readout_no_value"
            android:textColor="@color/accent_yellow"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="142.70" />

        <TextView
            android:id="@+id/readoutChannelUnit"
            style="@style/TextAppearance.UNO.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="2dp"
            tools:text="°" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/readoutChannelMeter"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:progressDrawable="@drawable/readout_meter"
        tools:progress="400" />

    <TextView
        android:id="@+id/readoutChannelToken"
        style="@style/TextAppearance.UNO.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_readout_token"
        android:fontFamily="monospace"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp"
        tools:text="[orientation: azimuth]" />

</LinearLayout>
