<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".screens.fragments.SensorsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Left: the catalog, as a 3-wide grid. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/sensors_header_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sensors" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.01"
                        android:text="@string/sensors_title"
                        android:textColor="@color/text_primary_light"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sensors_subtitle"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sensorGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:contentDescription="@string/sensors_grid_description"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="24dp"
                android:scrollbars="vertical"
                tools:itemCount="6"
                tools:listitem="@layout/item_sensor_card" />

        </LinearLayout>

        <!-- Right: what the user has picked so far. -->
        <LinearLayout
            android:layout_width="252dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_side_panel"
            android:orientation="vertical">


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                >

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/selectedSensorList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:contentDescription="@string/sensors_selected_description"
                    android:paddingStart="14dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="88dp"
                    android:scrollbars="vertical"
                    tools:listitem="@layout/item_selected_sensor" />

                <TextView
                    android:id="@+id/selectedSensorEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="40dp"
                    android:text="@string/sensors_selected_empty"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12sp" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/nextScreenButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/sensors_next"
        android:focusable="false"
        android:src="@drawable/ic_arrow_forward"
        app:backgroundTint="#F5A623"
        app:elevation="6dp"
        app:fabSize="normal"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Fab.Circle"
        app:tint="#FFFFFFFF" />

</FrameLayout>
