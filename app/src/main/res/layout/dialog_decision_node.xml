<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.06"
        android:text="Sensor"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary_light"
        android:textSize="11sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/decision_sensor_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/decision_sensor_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="Choose a sensor"
            android:inputType="none"
            android:textColor="@color/text_primary_light"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/decision_sensor_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:text="No sensors selected yet. Pick them on the Sensors screen first."
        android:textColor="@color/accent_red"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/decision_sensor_values_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.06"
        android:text="Values"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary_light"
        android:textSize="11sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:id="@+id/decision_sensor_channels_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/decision_sensor_channels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- Condition block only: centred, unlike the start-aligned sections above. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="Condition"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/decision_condition_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="20dp"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/decision_condition_operators"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />

            <EditText
                android:id="@+id/decision_condition_value"
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_condition_input"
                android:gravity="center"
                android:hint="0"
                android:inputType="numberDecimal|numberSigned"
                android:maxLength="10"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:saveEnabled="false"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/decision_condition_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_secondary_light"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/decision_condition_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Tap a value above to set the condition."
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="2dp"
        android:text="One test per block — true takes Yes, false takes No. To combine tests, put another Decision on the branch."
        android:textColor="@color/text_secondary_light"
        android:textSize="12sp" />

</LinearLayout>
