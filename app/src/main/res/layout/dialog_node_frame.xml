<?xml version="1.0" encoding="utf-8"?><!--
    Root padding leaves room for the card's shadow, which the fixed-size dialog window
    would otherwise clip.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/surface_light"
        app:cardCornerRadius="26dp"
        app:cardElevation="14dp"
        app:strokeColor="@color/divider_light"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingTop="20dp"
                android:paddingEnd="14dp"
                android:paddingBottom="18dp">

                <!--
                    android:tint, not app:tint: this dialog is a plain android.app.Dialog, so
                    its inflater does not swap in AppCompatImageView and app:tint is ignored.
                -->
                <ImageView
                    android:id="@+id/node_dialog_close"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Close"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_secondary_light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/node_dialog_close"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/node_dialog_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.01"
                        android:textColor="@color/text_primary_light"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/node_dialog_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_light" />

            <!-- Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/node_dialog_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="20dp" />

            </ScrollView>

            <!-- Footer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/node_dialog_done"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="18dp"
                android:letterSpacing="0.01"
                android:stateListAnimator="@null"
                android:text="Done"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_blue"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
