<?xml version="1.0" encoding="utf-8"?><!--
    Root padding leaves room for the card's shadow and for the close chip, which deliberately
    overhangs the card's top-right corner. clipChildren/clipToPadding must stay false or the
    overhang is cut off.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="@color/surface_light"
            app:cardCornerRadius="26dp"
            app:cardElevation="14dp"
            app:strokeColor="@color/divider_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Header: title only, the close chip lives outside the card body -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="44dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:id="@+id/node_dialog_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.01"
                        android:textColor="@color/text_primary_light"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/node_dialog_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_light" />

                <!--
                    0dp + weight=1 is what makes this scroll: the ScrollView takes the space the
                    header leaves, and anything taller than that scrolls. wrap_content here
                    would size the viewport to the content and scroll nothing.
                    Do NOT add fillViewport="true".
                -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/node_dialog_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="26dp" />

                </ScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/node_dialog_close"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_gravity="top|end"
            android:contentDescription="Close"
            android:elevation="18dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />

    </FrameLayout>

</FrameLayout>