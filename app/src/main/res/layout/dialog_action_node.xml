<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Mode -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.06"
        android:text="Action type"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary_light"
        android:textSize="11sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/action_mode_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/action_mode_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cursorVisible="false"
            android:focusable="false"
            android:inputType="none"
            android:textColor="@color/text_primary_light"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Sensor mode: pick a sensor, then tap a value to drop its token into the command -->
    <LinearLayout
        android:id="@+id/action_sensor_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.06"
            android:text="Sensor"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/action_sensor_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/action_sensor_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="Choose a sensor"
                android:inputType="none"
                android:textColor="@color/text_primary_light"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/action_sensor_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="No sensors selected yet. Pick them on the Sensors screen first."
            android:textColor="@color/accent_red"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/action_sensor_values_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.06"
            android:text="Values"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/action_sensor_channels_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/action_sensor_channels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Command mode -->
    <LinearLayout
        android:id="@+id/action_command_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.06"
            android:text="Command"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/action_command_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:counterEnabled="true"
            app:counterMaxLength="240">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/action_command_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="e.g. motor.forward(120)"
                android:inputType="textMultiLine|textNoSuggestions|textVisiblePassword"
                android:maxLength="240"
                android:minLines="4"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:scrollbars="vertical"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/action_command_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="Sent to the device exactly as written when the flow reaches this step."
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- API mode: placeholder until the real thing lands -->
    <LinearLayout
        android:id="@+id/action_api_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_node_action"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API calls aren't ready yet"
            android:textColor="@color/text_primary_light"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="Pick Command for now. This step will do nothing while it's set to API."
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>