        android:pathData="M4.6,12 a7.4,7.4 0 1,0 14.8,0 a7.4,7.4 0 1,0 -14.8,0"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6" />
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-55">
