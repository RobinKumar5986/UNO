<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.UNO" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorOnPrimary">@color/surface_dark</item>

        <item name="colorSecondary">@color/accent_yellow</item>
        <item name="colorOnSecondary">@color/text_primary_dark</item>

        <item name="colorTertiary">@color/accent_green</item>
        <item name="colorOnTertiary">@color/surface_dark</item>

        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>

        <item name="colorError">@color/color_error</item>

        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>